  doi = {10.1186/s12967-025-06215-w},
  abstract = {Preclinical evidence suggests that young plasma has beneficial effects on multiple organ systems in aged mice. Whether young plasma exerts beneficial effects in an aging human population remains highly controversial. Despite lacking data, young donor plasma infusions have been promoted for age-related conditions. Given the preclinical evidence that young plasma exerts beneficial effects by attenuating inflammation, this study examined whether administering a young plasma protein fraction to an elderly population would exert anti-inflammatory and immune modulating effects in humans, using surgery as a tissue injury model.},
  language = {en},
  number = {1},
  journal = {Journal of Translational Medicine},
  author = {Gaudilliere, Brice and Xue, Lei and Tsai, Amy S. and Gao, Xiaoxiao and McAllister, Tiffany N. and Tingle, Martha and Porras, Gladys and Feinstein, Igor and Feyaerts, Dorien and Verdonk, Franck and Sabayev, Maximilian and Hedou, Julien and Ganio, Edward A. and Berson, Eloïse and Becker, Martin and Espinosa, Camilo and Kim, Yeasul and Lehallier, Benoit and Rawner, Esther and Feng, Chunmiao and Amanatullah, Derek F. and Huddleston, James I. and Goodman, Stuart B. and Aghaeepour, Nima and Angst, Martin S.},
  month = feb,
  year = {2025},
  keywords = {Aging, Elderly population, Immune cells, Inflammaging, Inflammation, Proteomics, Surgery, Tissue injury, Young plasma},
  pages = {183}
}

@incollection{siegl2025subroc,
  title = {{SubROC}: {AUC}-{Based} {Discovery} of {Exceptional} {Subgroup} {Performance} for {Binary} {Classifiers}},
  shorttitle = {{SubROC}},
  url = {https://ebooks.iospress.nl/doi/10.3233/FAIA250998},
  doi = {10.3233/FAIA250998},
  abstract = {Machine learning (ML) is increasingly employed in real-world applications like medicine or economics, thus, potentially affecting large populations. However, ML models often do not perform homogeneously, leading to underperformance or, conversely, unusually high performance in certain subgroups (e.g., sex=female \${\textbackslash}wedge\$ marital{\textbackslash}\_status=married). Identifying such subgroups can support practical decisions on which subpopulation a model is safe to deploy or where more training data is required. However, an efficient and coherent framework for effective search is missing. Consequently, we introduce {\textbackslash}emph\{SubROC\}, an open-source, easy-to-use framework based on Exceptional Model Mining for reliably and efficiently finding strengths and weaknesses of classification models in the form of interpretable population subgroups. SubROC incorporates common evaluation measures (ROC and PR AUC), efficient search space pruning for fast exhaustive subgroup search, control for class imbalance, adjustment for redundant patterns, and significance testing. We illustrate the practical benefits of SubROC in case studies as well as in comparative analyses across multiple datasets.},
  language = {en},
  booktitle = {{ECAI} 2025},
  publisher = {IOS Press},
  author = {Siegl, Tom and Coşkun, Kutalmış and Hiller, Bjarne C. and Mirzaei, Amin and Lemmerich, Florian and Becker, Martin},
  year = {2025},
  doi = {10.3233/FAIA250998},
  pages = {1703--1710},
  projects = {themis}
}

