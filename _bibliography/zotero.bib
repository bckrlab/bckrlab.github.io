@article{kim2026pregmednet,
  title = {{PregMedNet}: {Multifaceted} maternal medication impacts on neonatal complications},
  volume = {17},
  copyright = {2026 The Author(s)},
  issn = {2041-1723},
  shorttitle = {{PregMedNet}},
  url = {https://www.nature.com/articles/s41467-026-75000-0},
  doi = {10.1038/s41467-026-75000-0},
  abstract = {While medication use is common among pregnant women, medication safety remains insufficiently characterized because studies in pregnant women are challenging due to safety concerns. The recent digitization of healthcare databases and advances in computational methods have created new opportunities for large-scale, retrospective drug safety evaluations. Here, we present PregMedNet, a platform that characterizes multifaceted maternal medication associations on neonatal outcomes during pregnancy, covering more than 27,000 drug-disease pairs across 1,152 medications and 24 outcomes. These results encompass known and additional odds ratios (ORs), adjusted ORs, and drug-drug interactions, systematically analyzed using nationwide claims data and an advanced machine learning pipeline. Notably, one of the associations identified in this study is supported by in vivo experiments, increasing confidence in PregMedNet’s findings and highlighting the utility of claims data and machine learning for perinatal medication safety studies. Additionally, potential biological mechanisms underlying the associations are explored using a graph learning method, providing candidate pathways for future mechanistic investigations. We expect that PregMedNet will contribute to advancing maternal medication safety and improving neonatal outcomes by providing extensive, multifaceted drug safety information on this previously underrepresented population.},
  language = {en},
  number = {1},
  journal = {Nature Communications},
  publisher = {Nature Publishing Group},
  author = {Kim, Yeasul and Marić, Ivana and Kashiwagi, Chloe M. and Han, Lichy and Chung, Philip and Reiss, Jonathan D. and Butcher, Lindsay D. and Caoili, Kaitlin J. and Berson, Eloïse and Xue, Lei and Espinosa, Camilo and James, Tomin and Shome, Sayane and Xie, Feng and Ghanem, Marc and Seong, David and Chang, Alan L. and Reincke, S. Momsen and Mataraso, Samson and Shu, Chi-Hung and De Francesco, Davide and Becker, Martin and Kumar, Wasan M. and Wong, Ronald J. and Gaudilliere, Brice and Angst, Martin S. and Shaw, Gary M. and Bateman, Brian T. and Stevenson, David K. and Prince, Lawrence S. and Aghaeepour, Nima},
