@techreport{siegl2026latentsubgroups,
  title = {Latent {Subgroups}: {Testing} the {Assumptions} {Behind} {GDRO} in {GEORGE}},
  url = {https://bckrlab.org/files/siegl2026latentsubgroups.pdf},
  pdf = {siegl2026latentsubgroups.pdf},
  abstract = {GEORGE is a two-stage method for robustness to hidden subclasses: it clusters the feature space of a model trained by empirical risk minimization (ERM) within each class and then trains a new model with group distributionally robust optimization (GDRO), using the clusters as groups. Both stages rest on assumptions that are rarely tested in isolation. We test two of them. First, we check whether the quality of GEORGE’s clusterings predicts how much the GDRO stage improves over ERM. Across ten replications on each of MNIST, Waterbirds, ISIC and CelebA, there is not a clear trend in terms of correlation. Cluster-score gating of the GDRO stage is therefore not supported. Second, we check whether GDRO is a safe objective once a group is intrinsically hard, i.e. when its classes overlap. On a synthetic four-Gaussian problem with a linear model, GDRO finds the same mean decision boundary as ERM, but its decision boundaries vary much more from run to run once the hard groups overlap strongly. When the hard groups carry no class signal at all, GDRO’s boundaries become arbitrary. This instability is not explained by lagging group weights, by groups being split by class, or by the optimizer hyperparameters. It follows from GDRO assigning near-zero weight to the easy groups, which then no longer constrain the model.},
  language = {en},
  institution = {University of Rostock and Marburg University, Becker Lab},
  author = {Siegl, Tom and Becker, Martin},
  year = {2026},
  projects = {themis}
}

@unpublished{coskun2026informed,
  title = {Informed, but {Not} {Always} {Improved}: {Challenging} the {Benefit} of {Background} {Knowledge} in {GNNs}},
  abstract = {Biological background knowledge (BK) graphs, such as protein-protein interactions (PPIs), are widely used to guide graph neural networks (GNNs) toward biologically informed predictions, especially in low-sample, high-dimensional settings. Yet a basic question remains largely untested: do these models actually use the provided biological graph, and what happens when that graph is incomplete, noisy, or biased? In this work, we systematically probe BK utilization through random and targeted perturbations across two cancer-related tasks: graphlevel cancer subtype classification and node-level cancer gene detection. Contrary to expectations, in cancer subtype classification, uninformed baselines outperform BK-informed GNNs and graph perturbations have negligible effect, suggesting that the provided biological networks are barely used at all. In cancer gene detection, we find stronger but highly model-dependent use of the PPI graph, ranging from topology-dominated behavior to more balanced use of graph structure and node features. We complement our real-world findings with controlled synthetic graph- and node-classification experiments to provide a positive control: when graph informativeness is ensured by construction, informed GNNs outperform uninformed baselines and degrade predictably under perturbation. Overall, our results challenge the assumption that adding biological BK automatically improves GNN performance, and show that its contribution must be explicitly tested through perturbations, a shift we argue should become standard practice when reporting BK-informed GNNs. Our code is publicly available at bckrlab.org/p/bk-buster.},
  language = {en},
  author = {Coşkun, Kutalmış and Blanke, Felix and Cangalovic, Vanja Sophie and Hiller, Bjarne C. and Mirzaei, Amin and Siegl, Tom and Lüdtke, Stefan and Becker, Martin},
  year = {2026},
  note = {Under review},
  projects = {themis}
}

