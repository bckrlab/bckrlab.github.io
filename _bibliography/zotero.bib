@article{payrovnaziri2026dynamic,
  title = {Dynamic trajectories of neonatal laboratory measurements in the first 26 weeks of life},
  copyright = {2026 The Author(s)},
  issn = {2398-6352},
  url = {https://www.nature.com/articles/s41746-026-03142-y},
  doi = {10.1038/s41746-026-03142-y},
  abstract = {Laboratory measurements are vital for obtaining quantitative updates on patient’s health status. This study focused on analyzing 1173 distinct types of laboratory measurements collected from 34,605 infants, including {\textasciitilde}12\% born preterm ({\textless}37 weeks gestation) and {\textasciitilde}88\% born term admitted to the Stanford Children’s Hospitals utilizing electronic health records spanning from birth to 26 weeks of age. Our objective was to uncover temporal patterns and interdependencies among the measurements to characterize longitudinal laboratory trajectories during early infancy and identify potential biomarkers during this critical window of neonatal care. Correlation networks were constructed, revealing clustering patterns within the measurements. Notably, a distinct trend was observed in neutrophil counts, exhibiting a decreasing trend until around 12 weeks, followed by a subsequent increase until 26 weeks. This inflection point may reflect a transition phase in early immune system maturation beyond the immediate neonatal period, a stage that remains relatively under characterized in clinical studies. This significant observation was validated with the de-identified laboratory measurements recorded for 10,765 infants admitted in UCSF Benioff’s Hospital. Further, we explored the underlying potential clinical factors associated with the observed trend and found a significant association between observed white blood cell counts and the Phecode category, which includes congenital heart diseases (CHD). This data-driven analysis provides insights into immune trajectories during early infancy [https://neonatesmeasures2025.streamlit.app/] highlighting the potential for applying data analytics for prognosis and early medical interventions.},
  language = {en},
  journal = {npj Digital Medicine},
  publisher = {Nature Publishing Group},
  author = {Payrovnaziri, Seyedeh Neelufar and Shome, Sayane and Costello, Jean and Reiss, Jonathan D. and Maric, Ivana and Seong, David and Bernal, Camilo Espinosa and Phongpreecha, Thanaphong and Xie, Feng and Kim, Yeasul and Berson, Eloise and Shu, Chi-Hung and Saarunya, Geetha and Tan, Yuqi and Hazra, Debapriya and Oskotsky, Tomiko T. and De Francesco, Davide and Becker, Martin and Mohammadi, Neshat and Xue, Lei and Shaw, Gary M. and Sirota, Marina and Stevenson, David K. and Prince, Lawrence S. and Aghaeepour, Nima},
  month = aug,
  year = {2026},
  keywords = {Biomarkers, Computational biology and bioinformatics, Diseases, Health care, Medical research}
}

@misc{qadri2026cytobert,
  title = {{CytoBERT}: {A} {Foundation} {Model} for {Cytometry} {Data}},
