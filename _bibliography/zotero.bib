@article{voncramon-taubadel2026explainable,
  title = {Explainable {AI} for impact detection in smart composites: insights into transfer learning and model robustness},
  volume = {35},
  issn = {0964-1726},
  shorttitle = {Explainable {AI} for impact detection in smart composites},
  url = {https://doi.org/10.1088/1361-665X/ae8227},
  doi = {10.1088/1361-665X/ae8227},
  abstract = {Smart composite structures have substantial utility in high-performance applications such as aerospace and wind energy, where real-time impact detection is essential for structural health monitoring (SHM). machine learning (ML) enables the use of low-cost micro-electromechanical systems (MEMS) accelerometers for impact localization; however, existing approaches often lack robustness outside controlled laboratory conditions. In this study, we propose a full-stack framework for systematic evaluation of ML methods for impact localization on smart composites. The contributions include: (i) a customizable experimental setup for efficient data acquisition, (ii) a software framework for training and benchmarking ML and deep learning models under varying conditions, (iii) a regression-based architecture with improved accuracy, robustness, and transferability, (iv) transfer learning for efficient adaptation across structural configurations, and (v) explainable artificial intelligence (XAI) components for physical interpretation. Our results show that the proposed regression approach is robust to small deviations in the experimental setup ( accuracy loss), though larger variations, such as structural modifications, significantly degrade the models’ performance. Regression models consistently outperform classification methods, with gains of 1\%–5\% under minor variations and up to 33\% under severe changes. Transfer learning reduces required training data by 88\% while maintaining accuracy within 2\% of a fully trained model. Integrated gradients further provide preliminary insight into the underlying localization mechanisms. These results demonstrate improved robustness, data efficiency, and interpretability, supporting the deployment of data-driven SHM in real-world smart composite structures.},
  language = {en},
  number = {7},
  journal = {Smart Materials and Structures},
  publisher = {IOP Publishing},
  author = {von Cramon-Taubadel, Emanuel and Becker, Martin and Weißgraeber, Philipp},
  month = jul,
  year = {2026},
  pages = {075023}
}

@article{berlin2026machine,
  title = {Machine learning–guided multimodal profiling defines perturbed immune states at the time of cancer diagnosis},
  volume = {27},
  issn = {1477-4054},
  url = {https://doi.org/10.1093/bib/bbag320},
  doi = {10.1093/bib/bbag320},
  abstract = {Altered immune states at the time of cancer diagnosis remain insufficiently characterized. Although circulating immune biomarkers offer a promising, non-invasive way of analysing systemic tumour–host interactions, their potential remains poorly defined. Here, we present an integrated multi-omics analysis of peripheral blood mononuclear cells from treatment-naïve cancer patients, minimizing confounding by therapy-induced immune changes, combining immune phenotyping (flow cytometry, FC), multiplex cytokine profiling, and single-cell RNA sequencing (scRNA-seq). Compared with healthy donors, patients exhibited widespread immune dysregulation, including expansion of FOXP3+ regulatory T cells, depletion of CD16+CD11b+ monocytes and CD56{\textasciicircum}dim{\textasciicircum} Natural killer (NK) cells, and elevated plasma IL-6 and IL-4 levels. scRNA-seq identified cancer-associated immune signatures, notably consistent upregulation of THBS1 and CH25H, indicative of systemic imprinting by tumour-derived cues. We further developed machine learning-guided models integrating single-cell multi-omics data (sc-FC and scRNA-seq) to characterize cancer-associated immune patterning and cancer type–related signal structure, while providing biologically interpretable feature attribution across modalities. The models achieved robust classification performance within the cohort and revealed modality-spanning features linked to immune state alterations.Together, these findings establish a framework for immune-based, multi-omics profiling of peripheral blood and provide a resource for discovering circulating cancer-associated immune signatures. This supports future development of immune-based diagnostics and disease monitoring approaches.},
  number = {3},
  journal = {Briefings in Bioinformatics},
  author = {Berlin, Peggy and Mirzaei, Amin and Steinbeck, Felix and Becker, Martin and Müller-Hilke, Brigitte and Bergmann-Ewert, Wendy and Dubinski, Daniel and Freiman, Thomas M and Strüder, Daniel and Momper, Theresa and Wolff, Annabell and Kaps, Philipp and Henne, Julia and Schafmayer, Clemens and Linnebacher, Michael and Wagner, Charlotte and Rischmüller, Karen and Philipp, Martin and Lamprecht, Georg and Meissner, Paul and Schulz, Karoline and Junghanss, Christian and Kreikemeyer, Bernd and Oehmcke-Hecht, Sonja and Maletzki, Claudia},
  month = may,
  year = {2026},
  keywords = {cancer, cell, rna, scrnaseq, seq, single},
  pages = {bbag320},
  projects = {themis}
}

